function trainedLSTM_network = RNN_LSTM(trainSequences, trainLabels,validationSequences, validationLabels)

    %parameters
    maxEpochs = 30; % In our research different number of epoch size was tried to improve network accuracy
    miniBatchSize = 20; % As a default, it is provided aroun 50 but, 50 mini batches gave us poor result and increased number of training time
    numHiddenUnits1 = 100;
    numHiddenUnits2 = 100;
    numClasses = 4;  %number of activities
%     label_name = {'sit';'fall';'walk';'sitdown'}; 
    label_name = {'standup';'fall';'sitdown';'walk'}; 
%     label_name = {'no-activity';'fall';'liedown'; 'sitting';'stand'; 'walk';'stand-sit'; 'walk-sit'}; 
    classNames = categorical(label_name);
    
    % set-up the network architecture, architecture is adopted from MATLAB
    % LSTM example
%     layers = [ ...
%         sequenceInputLayer(1) 
%         lstmLayer(numHiddenUnits,'OutputMode','last') 
%         dropoutLayer(0.1) %provides information about how many percentage of dropout, it is important to overfitting
%         fullyConnectedLayer(numClasses)
%         softmaxLayer('Name', 'softmax')
%         classificationLayer('Name', 'output','Classes', classNames)]; 
    
    % define the training options
%     options = trainingOptions('adam', ... % adam optimizer is utilized
%         'InitialLearnRate',1e-4, ...
%         'ExecutionEnvironment', 'gpu', ... % to perform training process, one single NVIDIA GPU is utilized
%         'MaxEpochs', maxEpochs, ... % number of runs over the complete data-set
%         'MiniBatchSize', miniBatchSize, ... % this is the number between 1 to total number of data
%         'GradientThreshold', Inf, ...
%         'Verbose', false, ...
%         'Plots', 'training-progress'); % This option provides to watch all training process on different window
    % 'ValidationFrequency', 20, ...
    % 'ValidationData', {validationSequences, validationLabels}, ... % validation data is utilized to validate the trained model during th process to prevent overfittinf
    % Afte all parameters are set, training options are arranged and
    % training data is provided network is started to train 
%             'ValidationData', {validationSequences, categorical(validationLabels{1,1})}, ... % validation data is utilized to validate the trained model during th process to prevent overfittinf
%         'ValidationFrequency', 50, ...
   
maxEpochs = 60; %60
miniBatchSize = 32;  %32
options = trainingOptions('adam', ...
    'MaxEpochs',maxEpochs, ...
    'MiniBatchSize',miniBatchSize, ...
    'InitialLearnRate',0.001,...
    'SequenceLength','longest', ...
    'GradientThreshold',1,...
    'ExecutionEnvironment',"gpu",...
    'Plots','training-progress',...
    'SequencePaddingDirection', 'right',...
    'ValidationFrequency', 10, ...
    'ValidationData', {validationSequences, categorical(validationLabels)}, ... % 
    'Verbose',false);

    
    labels = categorical(trainLabels);
     XTrain = trainSequences;
     YTrain = labels;
% 
      layers = [ ...
          sequenceInputLayer(256)
          lstmLayer(numHiddenUnits1, 'OutputMode', 'last')
          dropoutLayer(0.2)
          fullyConnectedLayer(4)
          softmaxLayer('Name', 'softmax')
          classificationLayer('Name', 'output','Classes', classNames)];
%        options = trainingOptions('adam', 'Plots', 'training-progress');
       trainedLSTM_network = trainNetwork(XTrain, YTrain, layers, options);
   
      
      
% layers = [ ...
% %           sequenceInputLayer(12)
% %           lstmLayer(100, 'OutputMode', 'last')
% %           fullyConnectedLayer(9)
% %           softmaxLayer
% %           classificationLayer];
%       options = trainingOptions('adam', 'Plots', 'training-progress');
      
%     trainedLSTM_network = trainNetwork(trainSequences, labels, layers, options);
%     net2 = train(net1,x,t,'useParallel','yes')
% y = net2(x,'useParallel','yes')
end