function result = RNN_LSTM_training 
% networkName = 'RNN_LSTM_Network';
trainDataPath = './data/realdata/input_data/30ms/csidata/sit/'; % train data path
validationDataPath = './data/realdata/input_data/30ms/csidata/validation/'; % validation data path
% testDataPath = './data/realdata/output_data/test/'; % test data path

% TRAINING DATA-SET
% select all files that end in '.mat' from the directory
% load trainedNet
[trainSequences, trainLabels] = createLSTMDataSet(trainDataPath);
% VALIDATION DATA-SET
% select all files that end in '.mat' from the directory
%  [validationSequences, validationLabels] = createLSTMDataSet(validationDataPath);
% TEST DATA-SET
% select all files that end in '.mat' from the directory
 [testSequences, testLabels] = createLSTMDataSet(validationDataPath);

% LSTM network is populated by train and validation data to train network
% and validation data is required to prevent overfitting
 trainedNet = RNN_LSTM(trainSequences, trainLabels,testSequences, testLabels); 

% save the trained network to file
RNN_LSTM_Network = trainedNet;
%save RNN_LSTM_Network;
result = trainedNet;
% Classify the test data.
% To reduce the amount of padding introduced by the classification process, set the mini-batch size to 20 same as in training model creation. 
% To apply the same padding as the training data, specify the sequence
% length to be 'longest'. Sequence length is set 'longest' as default.
miniBatchSize = 10; 
load trainedNet
predLabels = classify(trainedNet, testSequences, 'MiniBatchSize', miniBatchSize);

end
% calculation of classification accuracy of the predicted labels.
% acc = sum(predLabels == testLabels)./numel(testSequences);
% 
% %plot confusion matrix
% plotconfusion(testLabels,predLabels)